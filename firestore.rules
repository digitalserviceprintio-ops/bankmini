rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Admin Accounts
    match /adminAccounts/{adminId} {
      allow read: if isValidId(adminId);
      allow create, update: if isValidId(adminId) &&
        request.resource.data.id is string &&
        request.resource.data.username is string &&
        request.resource.data.username.size() >= 2 &&
        request.resource.data.username.size() <= 64 &&
        request.resource.data.schoolName is string &&
        request.resource.data.schoolName.size() <= 128;
    }

    // School Info & Profiles
    match /schools/{schoolId} {
      allow read: if isValidId(schoolId);
      allow create, update: if isValidId(schoolId) &&
        request.resource.data.adminId is string &&
        request.resource.data.schoolName is string &&
        request.resource.data.schoolName.size() >= 2 &&
        request.resource.data.schoolName.size() <= 150;
    }

    // Student Accounts & Passbooks
    match /students/{studentId} {
      allow read: if isValidId(studentId);
      allow create, update: if isValidId(studentId) &&
        request.resource.data.adminId is string &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 2 &&
        request.resource.data.name.size() <= 120 &&
        request.resource.data.nis is string &&
        request.resource.data.nis.size() <= 32 &&
        request.resource.data.balance is number &&
        request.resource.data.balance >= 0;
      allow delete: if isValidId(studentId);
    }

    // Savings Transactions (Audit log: creation allowed, immutable thereafter)
    match /transactions/{transactionId} {
      allow read: if isValidId(transactionId);
      allow create: if isValidId(transactionId) &&
        request.resource.data.adminId is string &&
        request.resource.data.studentId is string &&
        request.resource.data.type in ['deposit', 'withdraw'] &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0 &&
        request.resource.data.finalBalance is number &&
        request.resource.data.finalBalance >= 0;
      allow update, delete: if false;
    }

    // Class lists per institution
    match /classes/{classId} {
      allow read: if isValidId(classId);
      allow create, update: if isValidId(classId) &&
        request.resource.data.adminId is string &&
        request.resource.data.classes is list &&
        request.resource.data.classes.size() <= 100;
    }
  }
}
